{{!--
    Curator loot card.

    This is an access surface, not only an announcement: the button is the one loot
    entry point with no canvas permission gate, so it works for every player and for
    installs whose Blacksmith predates the token interaction registry.

    Blacksmith's card classes are reused deliberately so this matches every other
    Coffee Pub chat card. There is no styling API for chat cards.
--}}
<span style="visibility: hidden">coffeepub-hide-header</span>
<div class="blacksmith-card theme-default curator-loot-card">
    <div class="card-header">
        <i class="fas fa-coins"></i> Loot Dropped!
    </div>
    <div class="section-content">
        <p>{{tokenName}} has been defeated and dropped their belongings!</p>
        {{#if tokenUuid}}
            <button type="button" class="curator-loot-card-button" data-curator-loot-open="{{tokenUuid}}">
                <i class="fa-solid fa-hand-holding-heart"></i> Loot {{tokenName}}
            </button>
        {{/if}}
    </div>
</div>

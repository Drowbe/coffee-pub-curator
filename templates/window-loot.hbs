<div class="curator-loot-content">
    {{#if missing}}
        <div class="curator-loot-empty">This corpse is no longer available.</div>
    {{else}}
        <section class="curator-loot-section curator-loot-subject">
            <div class="curator-loot-subject-image">
                <img src="{{portraitImg}}" alt="{{tokenName}}">
            </div>
            <div class="curator-loot-subject-copy">
                <div class="curator-loot-kicker">Corpse</div>
                <div class="curator-loot-title">{{tokenName}}</div>
                <div class="curator-loot-description">{{itemCount}} item rows · {{currencyCount}} currencies</div>
            </div>
            {{!-- Bury is open to everyone; a GM always confirms before the token goes. --}}
            <button type="button" class="curator-loot-bury" data-action="bury" data-tooltip="Bury this body and remove the token">
                <i class="fa-solid fa-shovel"></i> Bury
            </button>
        </section>

        <section class="curator-loot-section curator-loot-actor">
            {{#if hasRecipient}}
                <img class="curator-loot-actor-portrait" src="{{recipientImg}}" alt="">
                <div class="curator-loot-actor-copy">
                    <small>Looting as</small>
                    <strong>{{recipientName}}</strong>
                </div>
                {{#if hasRecipientChoice}}
                    <button type="button" class="blacksmith-window-btn-secondary curator-loot-icon-btn"
                            data-action="changeRecipient" data-tooltip="Loot as a different character">
                        <i class="fa-solid fa-repeat"></i>
                    </button>
                {{/if}}
            {{else}}
                <img class="curator-loot-actor-portrait" src="icons/svg/mystery-man.svg" alt="">
                <div class="curator-loot-actor-copy">
                    <small>Looting as</small>
                    <strong class="curator-loot-warning">No character available</strong>
                </div>
            {{/if}}
        </section>

        <section class="curator-loot-section">
            <h3><span><i class="fa-solid fa-box-open"></i> Items</span><span class="curator-loot-count">{{itemCount}}</span></h3>
            {{#if hasItems}}
                <div class="curator-loot-item-list">
                    {{#each items}}
                        <div class="curator-loot-item" data-item-id="{{id}}">
                            <img src="{{img}}" alt="">
                            <div class="curator-loot-item-copy"><strong>{{name}}</strong><span>{{typeLabel}}</span></div>
                            <div class="curator-loot-amount" title="Available quantity"><small>QTY</small><strong>{{quantity}}</strong></div>
                            <div class="curator-loot-row-actions">
                                <button type="button" class="blacksmith-window-btn-secondary curator-loot-icon-btn" data-action="take" data-item-id="{{id}}"
                                        {{#unless ../hasRecipient}}disabled{{/unless}} data-tooltip="Take this">
                                    <i class="fa-solid fa-hand"></i>
                                </button>
                                <button type="button" class="blacksmith-window-btn-secondary curator-loot-icon-btn" data-action="give" data-item-id="{{id}}"
                                        data-tooltip="Give to another party member">
                                    <i class="fa-solid fa-hand-holding-heart"></i>
                                </button>
                                <button type="button" class="blacksmith-window-btn-secondary curator-loot-icon-btn" data-action="party" data-item-id="{{id}}"
                                        {{#unless ../hasParty}}disabled{{/unless}} data-tooltip="Send to the party inventory">
                                    <i class="fa-solid fa-users"></i>
                                </button>
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{else}}<div class="curator-loot-empty">No lootable items remain.</div>{{/if}}
        </section>

        <section class="curator-loot-section">
            <h3>
                <span><i class="fa-solid fa-coins"></i> Currency</span>
                <span class="curator-loot-head-actions">
                    {{#if hasCurrency}}
                        <button type="button" class="blacksmith-window-btn-secondary" data-action="distribute"
                                data-tooltip="Split evenly across the party; the remainder stays on the body">
                            <i class="fa-solid fa-scale-balanced"></i> Distribute
                        </button>
                    {{/if}}
                    <span class="curator-loot-count">{{currencyCount}}</span>
                </span>
            </h3>
            {{#if hasCurrency}}
                <div class="curator-loot-currency-list">
                    {{#each currencies}}
                        <div class="curator-loot-currency curator-loot-currency-{{key}}">
                            <div class="curator-loot-coin"><i class="fa-solid fa-coins"></i></div>
                            <div class="curator-loot-currency-copy"><strong>{{value}}</strong><span>{{label}} · {{abbreviation}}</span></div>
                            <div class="curator-loot-row-actions">
                                <button type="button" class="blacksmith-window-btn-secondary" data-action="takeCurrency" data-denom="{{key}}"
                                        {{#unless ../hasRecipient}}disabled{{/unless}} data-tooltip="Take some of this">
                                    <i class="fa-solid fa-hand"></i>
                                </button>
                                <button type="button" class="blacksmith-window-btn-secondary curator-loot-icon-btn" data-action="partyCurrency" data-denom="{{key}}"
                                        {{#unless ../hasParty}}disabled{{/unless}} data-tooltip="Send to the party inventory">
                                    <i class="fa-solid fa-users"></i>
                                </button>
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{else}}<div class="curator-loot-empty">No currency remains.</div>{{/if}}
        </section>
    {{/if}}
</div>

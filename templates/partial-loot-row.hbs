{{!--
    One loot row. Used twice: standalone, and inside a container group.

    Every flag it needs is precomputed on the row itself, deliberately — the two
    call sites sit at different context depths, so `../` lookups would resolve
    differently in each.
--}}
<div class="curator-loot-item{{#if looted}} curator-loot-item-looted{{/if}}{{#if packed}} curator-loot-item-packed{{/if}}" data-item-id="{{id}}">
    <img src="{{img}}" alt="">
    <div class="curator-loot-item-copy">
        <strong>{{name}}</strong>
        <span>{{#if packed}}{{contentLabel}}{{else}}{{typeLabel}}{{/if}}</span>
    </div>
    {{#if looted}}
        {{!-- The row stays so the body reads as a record of what was on it. --}}
        <div class="curator-loot-amount"><small>&nbsp;</small><strong>&mdash;</strong></div>
        <div class="curator-loot-row-actions">
            <span class="curator-loot-taken"><i class="fa-solid fa-check"></i> Looted by {{by}}</span>
        </div>
    {{else}}
        {{#if canRemoveContainer}}
            <div class="curator-loot-amount">
                <button type="button" class="curator-loot-remove" data-action="removeContainer" data-item-id="{{id}}"
                        data-tooltip="Remove this container">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        {{else if canEditQuantity}}
            <div class="curator-loot-amount curator-loot-amount-editable" data-edit-qty="{{id}}"
                 data-tooltip="Double-click to change; 0 removes it">
                <small>QTY</small><strong>{{quantity}}</strong>
            </div>
        {{else}}
            <div class="curator-loot-amount" title="Available quantity"><small>QTY</small><strong>{{quantity}}</strong></div>
        {{/if}}
        {{#if busy}}
            <div class="curator-loot-row-actions">
                <span class="curator-loot-blocked"><i class="fa-solid fa-circle-notch fa-spin"></i></span>
            </div>
        {{else if packed}}
            <div class="curator-loot-row-actions">
                <span class="curator-loot-blocked" data-tooltip="Take what is inside first; the bag can be taken once it is empty">
                    <i class="fa-solid fa-lock"></i> Empty it first
                </span>
            </div>
        {{else}}
            <div class="curator-loot-row-actions">
                <button type="button" class="blacksmith-window-btn-secondary curator-loot-icon-btn" data-action="take" data-item-id="{{id}}"
                        {{#unless canTake}}disabled{{/unless}} data-tooltip="Take this">
                    <i class="fa-solid fa-hand"></i>
                </button>
                {{#if showGive}}
                    <button type="button" class="blacksmith-window-btn-secondary curator-loot-icon-btn" data-action="give" data-item-id="{{id}}"
                            data-tooltip="Give to another party member">
                        <i class="fa-solid fa-hand-holding-heart"></i>
                    </button>
                {{/if}}
                {{#if showParty}}
                    <button type="button" class="blacksmith-window-btn-secondary curator-loot-icon-btn" data-action="party" data-item-id="{{id}}"
                            data-tooltip="Send to the party inventory">
                        <i class="fa-solid fa-users"></i>
                    </button>
                {{/if}}
            </div>
        {{/if}}
    {{/if}}
</div>
